{
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
    ] },
    { "source": "/(hero|concept|work)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" } ] }
  ]
}
